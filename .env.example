# Google Gemini API Key (Required for Live Audio Assistant)
# Get one at: https://aistudio.google.com/
GOOGLE_API_KEY=

# Gemini Live Voice Name: Puck | Charon | Fenrir | Aoede | Kore
GEMINI_VOICE=Puck

# Model Name
GEMINI_MODEL=gemini-3.8-live

# Cloudflare Worker license API. Configure the production URL before packaging.
JASPER_API_URL=http://localhost:8787

