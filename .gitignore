# ==========================================
# Jasper AI HUD - Git Ignore Rules
# ==========================================

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Build Outputs & Bundles
dist/
**/dist/
dist-electron/
out/
release/
build/
.expo/
**/.expo/

# Audit Harness & Ephemeral Outputs
.audit/

# TypeScript, Vite & Bundler Caches
*.tsbuildinfo
.vite/
.turbo/
.cache/
.parcel-cache/

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime & Process Data
pids
*.pid
*.seed
*.pid.lock

# Test Coverage & Bundles
coverage/
*.lcov
.nyc_output/
lib-cov/
test/*.mjs
test/_electron-mock.mjs
jasper-test-userdata/
test-userdata/

# Environment Files & Secrets (NEVER commit credentials)
.env
.env.*
!.env.example

# Editor & AI Assistant Caches
.vscode/
.idea/
.kilo/
.cursor/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# Operating System Files (Windows & macOS)
.DS_Store
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Compressed Files, Backups & Archives
*.rar
*.zip
*.7z
*.tar
*.gz
*.tgz
*.cab
*.iso

# Temporary & Scratch Files
scratch/
temp/
tmp/
downloads/
Documents/Jasper_Relatorios/
Documents/Jasper_Sessoes/
*.tmp
*.tmp.*
*.temp
*.bak
*.orig
*~

# Screenshots & Automated Captures
screenshots/
showcase-screenshots/

# Runtime OCR Models & Dynamic Assets
*.traineddata
*.traineddata.gz

# V8 Bytecode Cache
*.jsc

# Test Results & Artifacts
test-results/
playwright-report/

